import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency

# A/Bテストデータの読み込み
df = pd.read_csv("ab_test.csv")

# 基本確認
print("データ件数:", len(df))
print("カラム:", df.columns.tolist())

display(df.head())

# 必須カラムの存在確認
required_columns = [
    "experiment_id",
    "user_id",
    "experiment_group",
    "exposure_date",
    "exposed",
    "clicked",
    "purchased",
    "order_value"
]

assert all(col in df.columns for col in required_columns)

# グループ確認
assert set(df["experiment_group"].unique()) == {"Control", "Treatment"}

# ユーザー重複確認
assert df["user_id"].is_unique

# 購入フラグ確認
assert set(df["purchased"].unique()).issubset({0, 1})

# クリックフラグ確認
assert set(df["clicked"].unique()).issubset({0, 1})

print("✓ データ品質チェック完了")

summary = (
    df.groupby("experiment_group")
      .agg(
          users=("user_id", "count"),
          clicks=("clicked", "sum"),
          purchasers=("purchased", "sum"),
          revenue=("order_value", "sum")
      )
      .reset_index()
)

summary["click_rate"] = summary["clicks"] / summary["users"]
summary["conversion_rate"] = summary["purchasers"] / summary["users"]

summary["avg_order_value"] = np.where(
    summary["purchasers"] > 0,
    summary["revenue"] / summary["purchasers"],
    0
)

summary

control_rate = summary.loc[
    summary["experiment_group"] == "Control",
    "conversion_rate"
].iloc[0]

treatment_rate = summary.loc[
    summary["experiment_group"] == "Treatment",
    "conversion_rate"
].iloc[0]

lift = (treatment_rate / control_rate - 1) * 100

print(f"Control 購入率: {control_rate:.1%}")
print(f"Treatment 購入率: {treatment_rate:.1%}")
print(f"改善率（Lift）: {lift:+.1f}%")

contingency_table = pd.crosstab(
    df["experiment_group"],
    df["purchased"]
)

print("クロス集計表")
display(contingency_table)

chi2, p_value, dof, expected = chi2_contingency(
    contingency_table
)

print(f"χ²統計量: {chi2:.3f}")
print(f"p値: {p_value:.4f}") 

alpha = 0.05

if p_value < alpha:
    print("統計的に有意な差が確認されました。")
else:
    print("統計的に有意な差は確認できませんでした。")
